# Copy to .env.local and fill in. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Browser-side mirrors (same values as above; anon key is public-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Photo cleanup cron (app/api/cron/photo-cleanup). Any long random string,
# e.g. `openssl rand -hex 32`. Vercel sends it as "Authorization: Bearer <value>".
# The cron also needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above (server-only).
CRON_SECRET=
# Web Push reminders (lib/push.ts). Generate once with
# `npx web-push generate-vapid-keys`. Leave empty and push stays off (the
# in-app bell still works). The public key goes in both *_PUBLIC_KEY vars.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
# The reminder job (app/api/cron/notify) uses CRON_SECRET above; Supabase
# pg_cron calls it every 15 min (docs/notify-cron.sql).
