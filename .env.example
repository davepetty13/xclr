# Copy to .env.local and fill in. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Browser-side mirrors (same values as above; anon key is public-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Photo cleanup cron (app/api/cron/photo-cleanup). Any long random string,
# e.g. `openssl rand -hex 32`. Vercel sends it as "Authorization: Bearer <value>".
# The cron also needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above (server-only).
CRON_SECRET=
